# Docker Compose reads this file from the project root.
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_DOMAIN=api.example.com
# Frontend API origin used by Caddy CSP when serving the app too.
CLOUD_ORIGIN=https://api.example.com

# Optional encrypted off-host backup. Initialize this repository with restic init once.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
RUN_RESTORE_DRILL=false
